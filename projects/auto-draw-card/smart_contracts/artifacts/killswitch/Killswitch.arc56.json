                        }
                    ]
                }
            ],
            "recommendations": {}
        },
        {
            "name": "authorize",
            "args": [
                {
                    "type": "address",
                    "name": "account",
                    "desc": "The address of the user to check."
                },
                {
                    "type": "uint64",
                    "name": "asset",
                    "desc": "The asset the delegation must be enabled for."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Checks if the delegation is authorized for the (account, asset) pair.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "enable",
            "args": [
                {
                    "type": "address",
                    "name": "card",
                    "desc": "A card address owned by the caller, used to prove card ownership."
                },
                {
                    "type": "uint64",
                    "name": "asset",
                    "desc": "The asset to enable delegation for."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Enables AutoDraw delegation of the given asset for the caller.\n\nThe delegation is keyed by (Txn.sender, asset) \u2014 the same key `authorize` and `kill`\nuse, and the account the AutoDraw Lsig binds to the axfer sender.\n\nGated to accounts that own a card in the Main contract, to prevent abuse of the\nowner-funded box MBR. The caller must supply a card address they own; ownership is\nverified by reading the card box in the Main contract directly (AVM 13 foreign box\nread \u2014 Main opts in via appForeignBoxReads).",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "kill",
            "args": [
                {
                    "type": "uint64",
                    "name": "asset",
                    "desc": "The asset to disable delegation for."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Disables AutoDraw delegation of the given asset for the caller.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "killFor",
            "args": [
                {
                    "type": "address",
                    "name": "account",
                    "desc": "The account whose delegation is being revoked."
                },
                {
                    "type": "uint64",
                    "name": "asset",
                    "desc": "The asset to disable delegation for."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Disables AutoDraw delegation of the given asset on behalf of `account`.\n\nUnlike `kill`, a delegation that is not enabled is not an error. Main revokes on every\nasset opt-out and cannot tell which assets the holder actually delegated, so failing here\nwould block opting a card out of an asset it never delegated.",
            "events": [],
            "recommendations": {}
        },
        {
