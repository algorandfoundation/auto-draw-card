                }
            ],
            "returns": {
                "type": "address"
            },
            "actions": {
                "create": [
                    "NoOp"
                ],
                "call": []
            },
            "readonly": false,
            "desc": "Deploy the contract, setting the owner as provided and initializing global state.",
            "events": [
                {
                    "name": "OwnershipTransferred",
                    "args": [
                        {
                            "type": "address",
                            "name": "previousOwner"
                        },
                        {
                            "type": "address",
